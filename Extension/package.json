{
  "name": "qrshield-chrome-extension",
  "version": "1.0.0",
  "description": "Secure Chrome Extension for real-time URL risk analysis powered by QRShield API",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
