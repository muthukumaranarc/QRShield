# ========================================================
# QRShield Backend - Environment Configuration (Template)
# ========================================================

# Server Port
PORT=8080

# MySQL Database Configuration
MYSQL_URL=jdbc:mysql://localhost:3306/qrshield?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQL_USER=root
MYSQL_PASSWORD=your_secure_mysql_password

# MongoDB Atlas Connection String (Optional / Dual Compatibility)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/qrshield?retryWrites=true&w=majority

# VirtualBox Sandbox Manager Configuration
VBOX_EXECUTABLE_PATH=C:\Program Files\Oracle\VirtualBox\VBoxManage.exe
VBOX_BASE_VM_NAME=qrshield-ubuntu-base
VBOX_SNAPSHOT_NAME=clean-worker-ready
VBOX_USE_LINKED_CLONES=true
VBOX_HOST_ONLY_IF=VirtualBox Host-Only Ethernet Adapter
VBOX_WORKER_HOST=192.168.56.101
VBOX_WORKER_PORT=8085
VBOX_WORKER_AUTH_TOKEN=qrshield-sandbox-secure-token-2026
VBOX_STARTUP_TIMEOUT=45
VBOX_ANALYSIS_TIMEOUT=30
VBOX_MAX_CONCURRENT_VMS=2

# Download-to-Hash Malware Detection Pipeline
QRSHIELD_QUARANTINE_DIR=./data/quarantine
QRSHIELD_MAX_DOWNLOAD_BYTES=26214400
QRSHIELD_MAX_DOWNLOADS_PER_ANALYSIS=3
QRSHIELD_QUARANTINE_MAX_BYTES=524288000
QRSHIELD_DOWNLOAD_TIMEOUT_SECONDS=15
QRSHIELD_FILE_REPUTATION_ENABLED=true
QRSHIELD_VIRUSTOTAL_API_KEY=your_virustotal_v3_api_key_here
QRSHIELD_VIRUSTOTAL_TIMEOUT_SECONDS=5
QRSHIELD_MOCK_PROVIDER_ENABLED=true
